<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:gravity="end"
    android:paddingStart="48dp"
    android:paddingEnd="8dp"
    android:paddingTop="4dp"
    android:paddingBottom="4dp">

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/bg_card_hud"
        android:backgroundTint="#16243A"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:paddingTop="8dp"
        android:paddingBottom="6dp">

        <TextView
            android:id="@+id/tvOutgoingText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Water level rising fast, 3 people trapped!"
            android:textColor="#FFFFFF"
            android:textSize="13sp"
            android:fontFamily="sans-serif-medium" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_gravity="end"
            android:gravity="center_vertical"
            android:layout_marginTop="3dp">

            <TextView
                android:id="@+id/tvOutgoingMeta"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="16:42 • 40B Packet"
                android:textColor="#8B949E"
                android:textSize="9sp"
                android:fontFamily="monospace" />

            <!-- The WhatsApp-style Blue Tick! -->
            <TextView
                android:id="@+id/tvDeliveryTick"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:text="✓✓"
                android:textColor="#00E5FF"
                android:textSize="13sp"
                android:textStyle="bold"
                android:fontFamily="monospace" />
        </LinearLayout>

    </LinearLayout>
</LinearLayout>
