<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/hud_background"
    android:padding="8dp">

    <!-- ============================================================ -->
    <!-- TOP HEADER: BRAND & PEER RADAR STATUS                        -->
    <!-- ============================================================ -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingBottom="4dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="AIRHOP // iTANTRA"
                android:textColor="@color/accent_text_primary"
                android:textSize="17sp"
                android:textStyle="bold"
                android:fontFamily="monospace" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="OFFLINE NEURAL TRANSCEIVER // SIH26173"
                android:textColor="@color/accent_cyan"
                android:textSize="9sp"
                android:fontFamily="monospace" />
        </LinearLayout>

        <!-- Prominent Multi-Language Selector (10 Indian Languages + English) -->
        <Button
            android:id="@+id/btnSelectLanguage"
            android:layout_width="wrap_content"
            android:layout_height="34dp"
            android:background="@drawable/bg_badge"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:text="🌐 English ▼"
            android:textColor="@color/accent_cyan"
            android:textSize="10sp"
            android:textStyle="bold"
            android:fontFamily="monospace" />

        <!-- 72-Hour Disaster Battery Saver Mode Toggle -->
        <Button
            android:id="@+id/btnBatteryMode"
            android:layout_width="wrap_content"
            android:layout_height="34dp"
            android:layout_marginStart="4dp"
            android:background="@drawable/bg_badge"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:text="⚡ 100% PWR"
            android:textColor="#FFD600"
            android:textSize="10sp"
            android:textStyle="bold"
            android:fontFamily="monospace" />
    </LinearLayout>

    <!-- Mesh Peer & Zero-Contact Explanation Strip -->
    <Button
        android:id="@+id/btnNearbyPeers"
        android:layout_width="match_parent"
        android:layout_height="30dp"
        android:layout_marginBottom="4dp"
        android:background="@drawable/bg_card_hud"
        android:text="🟢 2 Nearby Relays Active • Zero Contacts Needed [ℹ️ Tap Info]"
        android:textColor="@color/accent_coded_phy"
        android:textSize="9sp"
        android:textStyle="bold"
        android:fontFamily="monospace"
        android:gravity="center"
        android:paddingStart="8dp"
        android:paddingEnd="8dp" />

    <!-- LIFE-SAVING ACTION BAR: SOS SIREN & STROBE, SITUATIONAL TRIAGE, FIRST AID -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="4dp">

        <Button
            android:id="@+id/btnSos"
            android:layout_width="0dp"
            android:layout_height="38dp"
            android:layout_weight="1.3"
            android:background="@drawable/bg_sos_button"
            android:text="🚨 SOS SIREN &amp; STROBE"
            android:textColor="#FFFFFF"
            android:textSize="9sp"
            android:textStyle="bold"
            android:fontFamily="monospace" />

        <Button
            android:id="@+id/btnTriageReport"
            android:layout_width="0dp"
            android:layout_height="38dp"
            android:layout_weight="1.1"
            android:layout_marginStart="4dp"
            android:background="@drawable/bg_badge"
            android:text="📋 TRIAGE REPORT"
            android:textColor="@color/accent_cyan"
            android:textSize="9sp"
            android:textStyle="bold"
            android:fontFamily="monospace" />

        <Button
            android:id="@+id/btnSurvivalGuide"
            android:layout_width="0dp"
            android:layout_height="38dp"
            android:layout_weight="1"
            android:layout_marginStart="4dp"
            android:background="@drawable/bg_card_hud"
            android:text="🩺 1ST AID GUIDE"
            android:textColor="#00E676"
            android:textSize="9sp"
            android:textStyle="bold"
            android:fontFamily="monospace" />
    </LinearLayout>

    <!-- Telemetry Badges Strip -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:weightSum="3"
        android:layout_marginBottom="4dp">

        <TextView
            android:id="@+id/tvBleStatus"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@drawable/bg_card_hud"
            android:padding="4dp"
            android:gravity="center"
            android:text="BLE: CODED + 1M"
            android:textColor="@color/accent_coded_phy"
            android:textSize="8sp"
            android:fontFamily="monospace" />

        <TextView
            android:id="@+id/tvWifiAwareStatus"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="3dp"
            android:layout_marginEnd="3dp"
            android:background="@drawable/bg_card_hud"
            android:padding="4dp"
            android:gravity="center"
            android:text="UDP: MESH ACTIVE"
            android:textColor="@color/accent_wifi_aware"
            android:textSize="8sp"
            android:fontFamily="monospace" />

        <TextView
            android:id="@+id/tvGpsStatus"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@drawable/bg_card_hud"
            android:padding="4dp"
            android:gravity="center"
            android:text="NAVIC: 12.2958°N"
            android:textColor="@color/accent_warning"
            android:textSize="8sp"
            android:fontFamily="monospace" />
    </LinearLayout>

    <!-- ============================================================ -->
    <!-- CHAT MESSAGES RECYCLER VIEW (WHATSAPP-STYLE WITH BLUE TICKS) -->
    <!-- ============================================================ -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvChatMessages"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="@drawable/bg_card_hud"
        android:backgroundTint="#0B0F17"
        android:padding="4dp"
        android:clipToPadding="false"
        android:scrollbars="vertical" />

    <!-- Waveform Visualizer (Compact) -->
    <com.team.vocalink.ui.TokenVisualizerView
        android:id="@+id/tokenVisualizerView"
        android:layout_width="match_parent"
        android:layout_height="32dp"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="4dp"
        android:background="@drawable/bg_card_hud" />

    <!-- ============================================================ -->
    <!-- QUICK EMERGENCY SPEECH PRESETS CHIPS (1-TAP DISASTER SPEECH) -->
    <!-- ============================================================ -->
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:scrollbars="none"
        android:layout_marginBottom="4dp">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/chipPresetFlood"
                android:layout_width="wrap_content"
                android:layout_height="30dp"
                android:background="@drawable/bg_badge"
                android:text="🚨 Flood Rising (3 Trapped)"
                android:textColor="@color/accent_sos"
                android:textSize="9sp"
                android:fontFamily="monospace"
                android:paddingStart="8dp"
                android:paddingEnd="8dp" />

            <Button
                android:id="@+id/chipPresetMedical"
                android:layout_width="wrap_content"
                android:layout_height="30dp"
                android:layout_marginStart="4dp"
                android:background="@drawable/bg_badge"
                android:text="🩺 Medical Emergency"
                android:textColor="@color/accent_warning"
                android:textSize="9sp"
                android:fontFamily="monospace"
                android:paddingStart="8dp"
                android:paddingEnd="8dp" />

            <Button
                android:id="@+id/chipPresetRubble"
                android:layout_width="wrap_content"
                android:layout_height="30dp"
                android:layout_marginStart="4dp"
                android:background="@drawable/bg_badge"
                android:text="🏚️ Trapped in Rubble"
                android:textColor="@color/accent_text_primary"
                android:textSize="9sp"
                android:fontFamily="monospace"
                android:paddingStart="8dp"
                android:paddingEnd="8dp" />

            <Button
                android:id="@+id/chipPresetWater"
                android:layout_width="wrap_content"
                android:layout_height="30dp"
                android:layout_marginStart="4dp"
                android:background="@drawable/bg_badge"
                android:text="💧 Need Drinking Water"
                android:textColor="@color/accent_cyan"
                android:textSize="9sp"
                android:fontFamily="monospace"
                android:paddingStart="8dp"
                android:paddingEnd="8dp" />

            <Button
                android:id="@+id/chipPresetEvac"
                android:layout_width="wrap_content"
                android:layout_height="30dp"
                android:layout_marginStart="4dp"
                android:background="@drawable/bg_badge"
                android:text="📍 Safe Evacuation Point"
                android:textColor="@color/accent_coded_phy"
                android:textSize="9sp"
                android:fontFamily="monospace"
                android:paddingStart="8dp"
                android:paddingEnd="8dp" />
        </LinearLayout>
    </HorizontalScrollView>

    <!-- ============================================================ -->
    <!-- BOTTOM INPUT DOCK: SPEECH-TO-TEXT MIC + EDIT TEXT + SEND     -->
    <!-- ============================================================ -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="4dp">

        <Button
            android:id="@+id/btnMicVoice"
            android:layout_width="52dp"
            android:layout_height="44dp"
            android:background="@drawable/bg_ptt_button"
            android:text="🎙️"
            android:textColor="#FFFFFF"
            android:textSize="18sp" />

        <EditText
            android:id="@+id/etMessageInput"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:layout_marginStart="6dp"
            android:layout_marginEnd="6dp"
            android:background="@drawable/bg_card_hud"
            android:hint="Speak on mic or type message..."
            android:textColorHint="#6E7681"
            android:textColor="#FFFFFF"
            android:textSize="12sp"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:maxLines="2" />

        <Button
            android:id="@+id/btnSendMessage"
            android:layout_width="64dp"
            android:layout_height="44dp"
            android:background="@drawable/bg_badge"
            android:text="SEND"
            android:textColor="@color/accent_cyan"
            android:textSize="11sp"
            android:textStyle="bold"
            android:fontFamily="monospace" />
    </LinearLayout>

    <!-- ============================================================ -->
    <!-- ACTION STRIP: TEST SIMULATION & LOG EXPORT                   -->
    <!-- ============================================================ -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btnDemoScenarios"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_weight="1.6"
            android:background="@drawable/bg_card_hud"
            android:text="🧪 TEST PEER ➔ BLUE TICK"
            android:textColor="@color/accent_coded_phy"
            android:textSize="9sp"
            android:textStyle="bold"
            android:fontFamily="monospace" />

        <Button
            android:id="@+id/btnExportLogs"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_weight="1"
            android:layout_marginStart="4dp"
            android:background="@drawable/bg_badge"
            android:text="EXPORT CSV"
            android:textColor="@color/accent_cyan"
            android:textSize="9sp"
            android:fontFamily="monospace" />
    </LinearLayout>

</LinearLayout>
