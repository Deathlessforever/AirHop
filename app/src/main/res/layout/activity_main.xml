<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/hud_background"
    android:padding="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingBottom="8dp">
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="AirHop"
                android:textColor="@color/accent_text_primary"
                android:textSize="24sp"
                android:textStyle="bold"/>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Offline emergency communication"
                android:textColor="@color/accent_cyan"
                android:textSize="11sp"/>
        </LinearLayout>
        <Button
            android:id="@+id/btnSelectLanguage"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:background="@drawable/bg_badge"
            android:text="English ▼"
            android:textColor="@color/accent_cyan"/>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="8dp">
        <TextView
            android:id="@+id/tvBleStatus"
            android:layout_width="0dp"
            android:layout_height="34dp"
            android:layout_weight="1"
            android:gravity="center"
            android:background="@drawable/bg_card_hud"
            android:text="Bluetooth: checking"
            android:textColor="@color/accent_coded_phy"
            android:textSize="10sp"/>
        <TextView
            android:id="@+id/tvWifiAwareStatus"
            android:layout_width="0dp"
            android:layout_height="34dp"
            android:layout_weight="1"
            android:layout_marginStart="4dp"
            android:gravity="center"
            android:background="@drawable/bg_card_hud"
            android:text="Wi-Fi Aware: checking"
            android:textColor="@color/accent_wifi_aware"
            android:textSize="10sp"/>
        <TextView
            android:id="@+id/tvGpsStatus"
            android:layout_width="0dp"
            android:layout_height="34dp"
            android:layout_weight="1"
            android:layout_marginStart="4dp"
            android:gravity="center"
            android:background="@drawable/bg_card_hud"
            android:text="Location: unavailable"
            android:textColor="@color/accent_warning"
            android:textSize="10sp"/>
    </LinearLayout>

    <Button
        android:id="@+id/btnNearbyPeers"
        android:layout_width="match_parent"
        android:layout_height="42dp"
        android:layout_marginBottom="8dp"
        android:background="@drawable/bg_card_hud"
        android:text="No nearby AirHop nodes observed"
        android:textColor="@color/accent_coded_phy"/>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="8dp">
        <Button
            android:id="@+id/btnSos"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:background="@drawable/bg_sos_button"
            android:text="SOS"
            android:textColor="#FFFFFF"
            android:textStyle="bold"/>
        <Button
            android:id="@+id/btnTriageReport"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:layout_marginStart="6dp"
            android:background="@drawable/bg_badge"
            android:text="Report"
            android:textColor="@color/accent_cyan"/>
        <Button
            android:id="@+id/btnSurvivalGuide"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:layout_marginStart="6dp"
            android:background="@drawable/bg_badge"
            android:text="First aid"
            android:textColor="#00E676"/>
    </LinearLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvChatMessages"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="@drawable/bg_card_hud"
        android:padding="6dp"
        android:clipToPadding="false"
        android:scrollbars="vertical"/>

    <com.team.vocalink.ui.TokenVisualizerView
        android:id="@+id/tokenVisualizerView"
        android:layout_width="match_parent"
        android:layout_height="28dp"
        android:layout_marginTop="6dp"
        android:layout_marginBottom="6dp"
        android:background="@drawable/bg_card_hud"/>

    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:scrollbars="none"
        android:layout_marginBottom="6dp">
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">
            <Button android:id="@+id/chipPresetFlood" android:layout_width="wrap_content" android:layout_height="34dp" android:background="@drawable/bg_badge" android:text="Flood" android:textColor="@color/accent_sos"/>
            <Button android:id="@+id/chipPresetMedical" android:layout_width="wrap_content" android:layout_height="34dp" android:layout_marginStart="4dp" android:background="@drawable/bg_badge" android:text="Medical" android:textColor="@color/accent_warning"/>
            <Button android:id="@+id/chipPresetRubble" android:layout_width="wrap_content" android:layout_height="34dp" android:layout_marginStart="4dp" android:background="@drawable/bg_badge" android:text="Trapped" android:textColor="@color/accent_text_primary"/>
            <Button android:id="@+id/chipPresetWater" android:layout_width="wrap_content" android:layout_height="34dp" android:layout_marginStart="4dp" android:background="@drawable/bg_badge" android:text="Water" android:textColor="@color/accent_cyan"/>
            <Button android:id="@+id/chipPresetEvac" android:layout_width="wrap_content" android:layout_height="34dp" android:layout_marginStart="4dp" android:background="@drawable/bg_badge" android:text="Evacuate" android:textColor="@color/accent_coded_phy"/>
        </LinearLayout>
    </HorizontalScrollView>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">
        <Button
            android:id="@+id/btnMicVoice"
            android:layout_width="52dp"
            android:layout_height="48dp"
            android:background="@drawable/bg_ptt_button"
            android:text="🎙"
            android:textSize="18sp"/>
        <EditText
            android:id="@+id/etMessageInput"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:layout_marginStart="6dp"
            android:layout_marginEnd="6dp"
            android:background="@drawable/bg_card_hud"
            android:hint="Type a message"
            android:textColorHint="#6E7681"
            android:textColor="#FFFFFF"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:maxLines="2"/>
        <Button
            android:id="@+id/btnSendMessage"
            android:layout_width="70dp"
            android:layout_height="48dp"
            android:background="@drawable/bg_badge"
            android:text="Send"
            android:textColor="@color/accent_cyan"/>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:layout_marginTop="6dp">
        <Button
            android:id="@+id/btnBatteryMode"
            android:layout_width="0dp"
            android:layout_height="34dp"
            android:layout_weight="1"
            android:background="@drawable/bg_badge"
            android:text="Battery"
            android:textColor="#FFD600"/>
        <Button
            android:id="@+id/btnExportLogs"
            android:layout_width="0dp"
            android:layout_height="34dp"
            android:layout_weight="1"
            android:layout_marginStart="6dp"
            android:background="@drawable/bg_badge"
            android:text="Export log"
            android:textColor="@color/accent_cyan"/>
    </LinearLayout>
</LinearLayout>