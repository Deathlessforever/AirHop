<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/hud_background"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical">
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="AirHop"
                android:textColor="@color/accent_text_primary"
                android:textSize="28sp"
                android:textStyle="bold"/>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Emergency communication • works without internet"
                android:textColor="@color/accent_cyan"
                android:textSize="12sp"/>
        </LinearLayout>
        <Button
            android:id="@+id/btnSelectLanguage"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:background="@drawable/bg_badge"
            android:text="English ▼"
            android:textColor="@color/accent_cyan"/>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:orientation="horizontal">
        <TextView android:id="@+id/tvBleStatus" android:layout_width="0dp" android:layout_height="38dp" android:layout_weight="1" android:gravity="center" android:background="@drawable/bg_card_hud" android:text="Bluetooth: checking" android:textColor="@color/accent_coded_phy" android:textSize="10sp"/>
        <TextView android:id="@+id/tvWifiAwareStatus" android:layout_width="0dp" android:layout_height="38dp" android:layout_weight="1" android:layout_marginStart="6dp" android:gravity="center" android:background="@drawable/bg_card_hud" android:text="Wi-Fi Aware: checking" android:textColor="@color/accent_wifi_aware" android:textSize="10sp"/>
        <TextView android:id="@+id/tvGpsStatus" android:layout_width="0dp" android:layout_height="38dp" android:layout_weight="1" android:layout_marginStart="6dp" android:gravity="center" android:background="@drawable/bg_card_hud" android:text="Location: unavailable" android:textColor="@color/accent_warning" android:textSize="10sp"/>
    </LinearLayout>

    <Button
        android:id="@+id/btnSos"
        android:layout_width="match_parent"
        android:layout_height="58dp"
        android:layout_marginTop="12dp"
        android:background="@drawable/bg_sos_button"
        android:text="SOS — SEND EMERGENCY ALERT"
        android:textColor="#FFFFFF"
        android:textSize="15sp"
        android:textStyle="bold"/>

    <Button
        android:id="@+id/btnNearbyPeers"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="8dp"
        android:background="@drawable/bg_card_hud"
        android:text="AirHop Map • nearby relay devices"
        android:textColor="@color/accent_coded_phy"
        android:textSize="13sp"/>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:text="MESSAGES"
        android:textColor="@color/accent_cyan"
        android:textSize="11sp"
        android:textStyle="bold"/>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvChatMessages"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="4dp"
        android:background="@drawable/bg_card_hud"
        android:padding="8dp"
        android:clipToPadding="false"
        android:scrollbars="vertical"/>

    <com.team.vocalink.ui.TokenVisualizerView
        android:id="@+id/tokenVisualizerView"
        android:layout_width="match_parent"
        android:layout_height="24dp"
        android:layout_marginTop="6dp"
        android:background="@drawable/bg_card_hud"/>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:gravity="center_vertical">
        <Button
            android:id="@+id/btnMicVoice"
            android:layout_width="52dp"
            android:layout_height="48dp"
            android:background="@drawable/bg_ptt_button"
            android:text="🎙"
            android:textSize="18sp"/>
        <EditText
            android:id="@+id/etMessageInput"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:layout_marginStart="6dp"
            android:layout_marginEnd="6dp"
            android:background="@drawable/bg_card_hud"
            android:hint="Type your emergency message"
            android:textColorHint="#6E7681"
            android:textColor="#FFFFFF"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:maxLines="2"/>
        <Button
            android:id="@+id/btnSendMessage"
            android:layout_width="72dp"
            android:layout_height="48dp"
            android:background="@drawable/bg_badge"
            android:text="Send"
            android:textColor="@color/accent_cyan"/>
    </LinearLayout>

    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:scrollbars="none">
        <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="horizontal">
            <Button android:id="@+id/chipPresetFlood" android:layout_width="wrap_content" android:layout_height="36dp" android:background="@drawable/bg_badge" android:text="Flood" android:textColor="@color/accent_sos"/>
            <Button android:id="@+id/chipPresetMedical" android:layout_width="wrap_content" android:layout_height="36dp" android:layout_marginStart="5dp" android:background="@drawable/bg_badge" android:text="Medical" android:textColor="@color/accent_warning"/>
            <Button android:id="@+id/chipPresetRubble" android:layout_width="wrap_content" android:layout_height="36dp" android:layout_marginStart="5dp" android:background="@drawable/bg_badge" android:text="Trapped" android:textColor="@color/accent_text_primary"/>
            <Button android:id="@+id/chipPresetWater" android:layout_width="wrap_content" android:layout_height="36dp" android:layout_marginStart="5dp" android:background="@drawable/bg_badge" android:text="Water" android:textColor="@color/accent_cyan"/>
            <Button android:id="@+id/chipPresetEvac" android:layout_width="wrap_content" android:layout_height="36dp" android:layout_marginStart="5dp" android:background="@drawable/bg_badge" android:text="Evacuate" android:textColor="@color/accent_coded_phy"/>
        </LinearLayout>
    </HorizontalScrollView>

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp">
        <Button android:id="@+id/btnTriageReport" android:layout_width="0dp" android:layout_height="38dp" android:layout_weight="1" android:background="@drawable/bg_badge" android:text="Report" android:textColor="@color/accent_cyan"/>
        <Button android:id="@+id/btnSurvivalGuide" android:layout_width="0dp" android:layout_height="38dp" android:layout_weight="1" android:layout_marginStart="5dp" android:background="@drawable/bg_badge" android:text="First aid" android:textColor="#00E676"/>
        <Button android:id="@+id/btnBatteryMode" android:layout_width="0dp" android:layout_height="38dp" android:layout_weight="1" android:layout_marginStart="5dp" android:background="@drawable/bg_badge" android:text="Battery" android:textColor="#FFD600"/>
        <Button android:id="@+id/btnSecurity" android:layout_width="0dp" android:layout_height="38dp" android:layout_weight="1" android:layout_marginStart="5dp" android:background="@drawable/bg_badge" android:text="Security" android:textColor="@color/accent_coded_phy"/>
        <Button android:id="@+id/btnExportLogs" android:layout_width="0dp" android:layout_height="38dp" android:layout_weight="1" android:layout_marginStart="5dp" android:background="@drawable/bg_badge" android:text="Logs" android:textColor="@color/accent_cyan"/>
    </LinearLayout>
</LinearLayout>